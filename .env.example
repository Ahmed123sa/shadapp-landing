# Copy to .env on the server. Never commit .env.
ADMIN_EMAIL=admin@shadmanagement.co
# Generate with:  node admin/hash-password.mjs "a password of at least 10 characters"
ADMIN_PASSWORD_HASH=
# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PORT=3100
HOST=127.0.0.1
BASE_PATH=/shad-app
# LOCAL defaults below. On the server set TRUST_PROXY=1 and SERVE_SITE=0 (see DEPLOY.md).
# TRUST_PROXY=1 marks the cookie Secure, so over plain http locally login would not stick.
TRUST_PROXY=0
# 1 = this server also serves site/ (local). 0 = nginx serves it (server).
SERVE_SITE=1
# SESSION_HOURS=8
# DATA_DIR=/var/lib/shad-app-landing
