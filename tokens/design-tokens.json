  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0, 0, 0, 0.18)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 0.75rem 2rem rgba(0, 0, 0, 0.28)"
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 2rem 5rem rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(240, 240, 240, 0.06)",
      "$description": "Only the phone and the floating fragments. Everything else is flat."
    },
    "focus-ring": {
      "$type": "shadow",
      "$value": "0 0 0 2px {semantic.surface.page}, 0 0 0 4px {semantic.focus.ring}"
    }
  },
  "motion": {
    "$description": "UI transitions never above 500ms. Scroll choreography is scroll-linked, not timed. Every motion has a prefers-reduced-motion branch.",
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "100ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "normal": {
        "$type": "duration",
        "$value": "250ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms"
      }
    },
    "easing": {
      "out": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0.7,
          0.2,
          1
        ]
      },
      "in": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      },
      "emphasized": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
