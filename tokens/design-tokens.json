      },
      "danger": {
        "$type": "color",
        "$value": "{primitive.red.700}",
        "$description": "Destructive only. Unused on this page; kept so intent stays explicit."
      },
      "danger-hover": {
        "$type": "color",
        "$value": "{primitive.crimson.800}"
      }
    },
    "accent": {
      "dot": {
        "$type": "color",
        "$value": "{primitive.crimson.600}",
        "$description": "The brand dot. Decorative fills, never text."
      }
